# --- Required ---
# Password for the single-user gate
APP_PASSWORD=change-me
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# 250 on the free plan, 1000 on Starter
SERPAPI_MONTHLY_QUOTA=250
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Soft monthly cap tracked by the app (also set a hard limit in the Claude Console)
CLAUDE_MONTHLY_BUDGET_USD=15
# Supabase project settings -> API. Use the secret key (sb_secret_...) or legacy service_role key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Random string; Vercel Cron sends it as a Bearer token to /api/cron/keepalive
CRON_SECRET=

# --- Optional ---
# "fixtures" serves saved JSON instead of calling SerpApi/Claude (local UI work, no quota used)
DATA_MODE=
