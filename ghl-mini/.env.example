# ---------------------------------------------------------------
# ghl-mini configuration. Copy to .env and fill in what you need.
# Everything here is optional except GHL_SECRET and the login vars.
# ---------------------------------------------------------------

# Server
PORT=4000
PUBLIC_URL=http://localhost:4000

# Required. 32+ random chars. Encrypts API keys stored in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GHL_SECRET=change-me-to-a-long-random-string

# First-run login. After the first boot these are ignored; change the
# password from Settings instead.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me

# Optional: skip the login screen entirely when running on localhost.
AUTH_DISABLED=false

# --- Integrations (all optional, all also settable in the Settings UI) ---

# Google Maps Places API -> lead scraping
GOOGLE_MAPS_API_KEY=

# Twilio -> click to call + SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email. provider = resend | mailgun | postmark | none
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=
MAILGUN_DOMAIN=

# Claude Code CLI used to actually run the six agents.
CLAUDE_BIN=claude
